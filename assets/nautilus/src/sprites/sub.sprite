# Brass survey submarine for nautilus-os.html, facing right. S is the stripe —
# one @variant per agent, in that agent's pipeline colour.
@sprite sub
@outline ink
@point lamp 17,5
@variant aronnax    S=research
@variant conseil    S=analyze
@variant ned        S=build
@variant cyrus      S=model
@variant lidenbrock S=test
@variant barbicane  S=deploy
@variant axel       S=remember

